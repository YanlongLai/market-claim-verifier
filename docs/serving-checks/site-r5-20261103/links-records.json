{
  "command": [
    ".venv/bin/python",
    "scripts/check_links.py"
  ],
  "runs": [
    {
      "output": "links-initial.log",
      "exit_code": 0,
      "retained_from": "recorded tool stdout; preliminary file was replaced during the final check"
    },
    {
      "output": "links-final.log",
      "exit_code": 0,
      "retained_from": "subprocess stdout"
    },
    {
      "output": "links-delivery.log",
      "exit_code": 0,
      "retained_from": "subprocess stdout; final receipt links"
    }
  ]
}
