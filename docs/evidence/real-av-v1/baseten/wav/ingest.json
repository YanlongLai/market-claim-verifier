            526
          ]
        },
        {
          "id": "turn-2",
          "text": "NFX was roughly in line with guidance. Operating expenses increased 6% driven by continued investments in R&D compute capacity and talent.",
          "turn_id": 1,
          "start_ms": 34620,
          "end_ms": 43820,
          "timing": "ASR turn boundaries; not word timestamps",
          "speaker": "A",
          "raw_span": [
            528,
            666
          ]
        },
        {
          "id": "turn-3",
          "text": "Operating margins increased slightly year over year to 50% driven by strong revenue growth platform efficiency gains and focused investments across our portfolio partially offset by sales mix shift to Azure.",
