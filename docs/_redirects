# Serve the site at the domain root (Cloudflare Pages). /site/ stays reachable as a redirect for old links.
/site/              /                     301
/site/index.html    /                     301
/                   /site/index.html      200
/styles.css         /site/styles.css      200
/script.js          /site/script.js       200
/data/*             /site/data/:splat     200
/img/*              /site/img/:splat      200
