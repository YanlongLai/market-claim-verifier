  "voice_units": {
    "v500": {
      "disclosure_origin": {
        "text": "DappGo existed before this hackathon.",
        "audio_sha256": "2c5d79344f919080a3bed5b49a4a4f86b14955c3f1f68a7534643d2682c3c948"
      },
      "disclosure_build": {
        "text": "Everything here was built from October 27 to November 4.",
        "audio_sha256": "a9df004aecad5ca4fcbf777e08a328853c4bb6ede1ac65c66b003c603777fb0f"
      }
    },
    "v501": {
      "post": {
        "text": "A finance post goes viral.",
        "audio_sha256": "272b510bae62e4603bb89f7668f9c2ca38fe186431607b3bffb0f6b78a6e21b3"
      },
      "reposts": {
        "text": "Thousands repost it.",
        "audio_sha256": "e033e460c3fcb9bc428e0687578435c87c1e6dd59fc0753807c2dc9a89303bc6"
      },
      "question": {
        "text": "Is it right?",
        "audio_sha256": "df87f64067b6e7076c92d16ab371e556ba0f2c72f6f24fa2bd4f6118c6308cd1"
      },
      "period": {
        "text": "This one has a real number \u2014 and the wrong period.",
        "audio_sha256": "3feaa445210b11acd45238b8ebf2783936b741e2bd7272461c61a30d86b79dee"
      },
      "stakes": {
        "text": "Numbers like this move money, and wrong numbers lose it.",
        "audio_sha256": "d94c3269ff166e6aad5753a855638092b0daf204fafe592f179e4edc8bc952bf"
      }
    },
    "v502": {
      "formats": {
        "text": "And it's not just text.",
        "audio_sha256": "91e832b8aa35d58b7d9d7f7d67230352b4829624797120daf32564620437c0ad"
      },
      "screenshot": {
        "text": "Screenshots,",
        "audio_sha256": "88b5499541c6b314b1edad03fddaf51a10899f9c0d90d0ca6ebf0450502ed719"
      },
      "pdf": {
        "text": "PDFs,",
        "audio_sha256": "dc455d9164d8c1cad405de6d0760020c207b080580e6578a2735dd3ef1e192d2"
      },
      "podcast": {
        "text": "podcasts,",
        "audio_sha256": "73cecc99e14e62df47d609c2c3cd27a473c7fc47e934e72fe192191255b78c3e"
      },
      "video": {
        "text": "videos \u2014 numbers everywhere.",
        "audio_sha256": "f49d633500eb8e589c3b3cf566e82998df61765b57467a9acd6c041bb7231025"
      },
      "question": {
        "text": "How do you check all of them?",
        "audio_sha256": "21727b9d7993a9d3e904c867df8b5ff6df9fffaf5ca43bfdec4f1810ed9f0c78"
      }
    },
    "v503": {
      "single": {
        "text": "Asking a model directly gets one in five right.",
        "audio_sha256": "f156e036acedfe2c94ee8222b018899efaa796e6a7b4164e49648d5c457a5809"
      },
      "agent": {
        "text": "Give the same model SEC evidence, and let a program decide:",
        "audio_sha256": "6cdeb3f2a8129c929e653aab569522d8bdb789c6d5724a84d4d83b245ab7f116"
      },
      "nine": {
        "text": "nine in ten \u2014",
        "audio_sha256": "67c3ceee79dfbee712d17315e25fd6bea595a6bc8c48fda2d5c96c92c4a3e3e3"
      },
      "heldout": {
        "text": "on held-out claims, 240 of 266.",
        "audio_sha256": "d6e81601a27fd76be54ef59986f88eaa3afc819903fab2e5cc7ad1fdd34fe7ba"
      }
    },
    "v504": {
      "model": {
        "text": "Meta's Muse Spark extracts each claim and picks the SEC lookup.",
        "audio_sha256": "9e55c5f2671b13db94e5ee80c5a7dbb438e849d349ce52b032afee4484be7197"
      },
      "program": {
        "text": "Python does the arithmetic and returns the verdict.",
        "audio_sha256": "a2fd00a2d19b1e22dc468035e3c40c90836ab2402bffd9042c46ec694a594268"
      },
      "principle": {
        "text": "Model proposes; program decides.",
        "audio_sha256": "9ceacf51feb57fa2a4391679cfe8170ee6dde5fc4d675152fc782287d0a742ce"
      }
    },
    "v505": {
      "live": {
        "text": "Live, on the site.",
        "audio_sha256": "907af26e3b9678edda78e2b55be40e0f9bece028d7243b7460e83d09cf915768"
      },
      "paste": {
        "text": "Paste the post.",
        "audio_sha256": "bf7db1048afd9e2eb2dad02b860a1910b6cb7b80f5a26be92c7e94bb9733a32d"
      },
      "tools": {
        "text": "Muse Spark calls the SEC tools.",
        "audio_sha256": "6c5520be9e0cd9e2ebaaee6c67a592e10875fa65ce563822fb6bf15f107eb6e7"
      },
      "evidence_ids": {
        "text": "Each filed number comes back with its evidence ID.",
        "audio_sha256": "531bd6817bd8490aaf61df858fcc7ae1213568fa2e064377d14b46de4d21e9db"
      },
      "thinking": {
        "text": "The clock is the whole request \u2014 SEC lookups and model reasoning included.",
        "audio_sha256": "b0565d2d86915601e1b5559eebb4ade50a3449f89c513e571db5865f6c02351c"
      },
      "claims": {
        "text": "Four claims.",
        "audio_sha256": "0473cfa425a4eabbea6cd3c826d7ed5329d8b01f9739ae667c74807c9eddc904"
      },
      "lookups": {
        "text": "Four tool calls.",
        "audio_sha256": "5a6191567c2dab4f7268766e414197801113f8f5d56ce6658ed922ebccf88b3e"
      },
      "decide": {
        "text": "Then the program decides.",
        "audio_sha256": "64982b5a70112ff970de41292ea18a4cd419a2ead55630cf7590c9aeb0619489"
      },
      "verdict": {
        "text": "Contradicted, with the filing.",
        "audio_sha256": "4cc7f1070cbf8d85d382d60744058247f9852faeae51bff53f4d33909f3faa0c"
      },
      "draft": {
        "text": "And here is the corrected draft.",
        "audio_sha256": "c17278e353596930d7505a3a818322e39d36b443bdc175f0363462fba200bb44"
      },
      "evidence": {
        "text": "Apple's annual revenue was $416.2 billion; the quarter was $102.5 billion.",
        "audio_sha256": "546b886cf008908f6aefef321e9be6215dba88435699752c41e9c65e77a80f1a"
      },
      "trace": {
        "text": "Every SEC call is on the record.",
        "audio_sha256": "e6efa62f5d80c8656421b46bcc9a6eab4fbb8a2d97d9731aa5bf979e4de1b0b6"
      },
      "each": {
        "text": "You can see each call.",
        "audio_sha256": "bf660e8727a811d9f07ee371198a223d712907acca762c7b1bcc97ad83fdcc75"
      },
      "program": {
        "text": "The program's verdict.",
        "audio_sha256": "c21aee40a682c36c291c9282e492eb6d97d33364fb98aa77a844f99a4f620169"
      },
      "receipt": {
        "text": "Cost and time, on the receipt.",
        "audio_sha256": "c3e87a77d477aff77f0177e853b4076bfde402a2f97f0b24c35fdba88dc4ee40"
      }
    },
    "v506": {
      "run": {
        "text": "The same check runs locally from the command line.",
        "audio_sha256": "b5f08574c50b15a5d6529719b53d23ae439da94618d756c98ac95a3452f8be6e"
      },
      "ocr": {
        "text": "screenshots through Muse OCR,",
        "audio_sha256": "90f00a0d4045d0016dc675fc4d9eb2ddd0b024c6cc6826b3bd0ed95c0e039fc8"
      },
      "asr": {
        "text": "audio through Muse Voice Transcribe.",
        "audio_sha256": "def872964ee4ba59126cc1eee3b624ca8e8f51f53968c145eb112f584dbffc3e"
      },
      "median": {
        "text": "On saved Threads posts, the median was 6.8 seconds.",
        "audio_sha256": "0e50060ead02eb55807a49a57a45c48bfa20da62f991fba229d392ee2e6f7f49"
      },
      "projection": {
        "text": "At that median, a thousand posts take about two hours on one worker.",
        "audio_sha256": "f6839f2c1b9710220efc3ab835d93575e26715c12212f66d6df7673570c1090f"
      }
    },
    "v507": {
      "accuracy": {
        "text": "Ninety point two percent on held-out claims.",
        "audio_sha256": "d90c2a245baf9cab62ce49ab03c7e2c6d850a6217b6661d2de1550267c8506a0"
      },
      "false_support": {
        "text": "It wrongly says 'supported' once in 139.",
        "audio_sha256": "ff025b0566ff76cc32007238d49973b891106dee63a17e1b465ef454c714d57f"
      },
      "cost_time": {
        "text": "Two cents and ten seconds a claim.",
        "audio_sha256": "d5fa51b9695bf61f9295eb7498fc6d48e680fe3e1f79a1bb2b066e79af08c1d4"
      },
      "coverage": {
        "text": "On real posts, coverage is reported separately from accuracy.",
        "audio_sha256": "fc06226c5d2056b88fb3bb3296249cbbc2105a43d3b7daa512903e666dce1349"
      }
    },
    "v508": {
      "filing": {
        "text": "Every number, checked against the filing.",
        "audio_sha256": "db3b45208e5f3ecc6138c00e3f59d0c81d133bcd0d0b989ffaafaa52322b22c6"
      },
      "url": {
        "text": "hackathon dot dappgo dot com.",
        "audio_sha256": "5ea6e8c72aac4b263c5f4282f51096738409b7f7cbf045aee894d682cb176ff4"
      }
    },
    "v509": {
      "credit": {
        "text": "Built with Meta Muse Spark, on Baseten.",
        "audio_sha256": "b1e32fdf9c7d924b3be934891b4c8966ba89b28dc3f965811a50a4ec9ba91dbe"
      },
      "wordmark": {
        "text": "DappGo.",
        "audio_sha256": "eaa8cd5e6d6814148574f4c34654b52df0b9e0b3d57bd3e29b11189e154950cf"
      }
    }
  }
}
