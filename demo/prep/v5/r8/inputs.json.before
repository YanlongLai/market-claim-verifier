{
  "version": 1,
  "voice_input": {
    "voice": {
      "engine": "breeze-tts-2",
      "mode": "clone",
      "ref_audio": "demo/assets/voice/narrator-ref.wav",
      "ref_text": "This is Market Claim Verifier. Paste a finance post, and every number is checked against the company's own SEC filings, with a link to the exact line that proves it.",
      "seed": 2026
    },
    "scenes": [
      {
        "id": "v500",
        "narration": "DappGo existed before this hackathon. Everything here was built from October 27 to November 4.",
        "cue_events": [
          {
            "event": "disclosure_origin",
            "narration": "DappGo existed before this hackathon."
          },
          {
            "event": "disclosure_build",
            "narration": "Everything here was built from October 27 to November 4."
          }
        ]
      },
      {
        "id": "v501",
        "narration": "A finance post goes viral. Thousands repost it. Is it right? This one has a real number \u2014 and the wrong period. Numbers like this move money, and wrong numbers lose it.",
        "cue_events": [
          {
            "event": "post",
            "narration": "A finance post goes viral."
          },
          {
            "event": "reposts",
            "narration": "Thousands repost it."
          },
          {
            "event": "question",
            "narration": "Is it right?"
          },
          {
            "event": "period",
            "narration": "This one has a real number \u2014 and the wrong period."
          },
          {
            "event": "stakes",
            "narration": "Numbers like this move money, and wrong numbers lose it."
          }
        ]
      },
      {
        "id": "v502",
        "narration": "And it's not just text. Screenshots, PDFs, podcasts, videos \u2014 numbers everywhere. How do you check all of them?",
        "cue_events": [
          {
            "event": "formats",
            "narration": "And it's not just text."
          },
          {
            "event": "screenshot",
            "narration": "Screenshots,"
          },
          {
            "event": "pdf",
            "narration": "PDFs,"
          },
          {
            "event": "podcast",
            "narration": "podcasts,"
          },
          {
            "event": "video",
            "narration": "videos \u2014 numbers everywhere."
          },
          {
            "event": "question",
            "narration": "How do you check all of them?"
          }
        ]
      },
      {
        "id": "v503",
        "narration": "Asking a model directly gets one in five right. Give the same model SEC evidence, and let a program decide: nine in ten \u2014 on held-out claims, 240 of 266.",
        "cue_events": [
          {
            "event": "single",
            "narration": "Asking a model directly gets one in five right."
          },
          {
            "event": "agent",
            "narration": "Give the same model SEC evidence, and let a program decide:"
          },
          {
            "event": "nine",
            "narration": "nine in ten \u2014"
          },
          {
            "event": "heldout",
            "narration": "on held-out claims, 240 of 266."
          }
        ]
      },
      {
        "id": "v504",
        "narration": "Meta's Muse Spark extracts each claim and picks the SEC lookup. Python does the arithmetic and returns the verdict. Model proposes; program decides.",
        "cue_events": [
          {
            "event": "model",
            "narration": "Meta's Muse Spark extracts each claim and picks the SEC lookup."
          },
          {
            "event": "program",
            "narration": "Python does the arithmetic and returns the verdict."
          },
          {
            "event": "principle",
            "narration": "Model proposes; program decides."
          }
        ]
      },
      {
        "id": "v505",
        "narration": "Live, on the site. Paste the post. Muse Spark calls the SEC tools. Each filed number comes back with its evidence ID. The clock is the whole request \u2014 SEC lookups and model reasoning included. Four claims. Four tool calls. Then the program decides. Contradicted, with the filing. And here is the corrected draft. Apple's annual revenue was $416.2 billion; the quarter was $102.5 billion. Every SEC call is on the record. You can see each call. The program's verdict. Cost and time, on the receipt.",
        "cue_events": [
          {
            "event": "live",
            "narration": "Live, on the site."
          },
          {
            "event": "paste",
            "narration": "Paste the post."
          },
          {
            "event": "tools",
            "narration": "Muse Spark calls the SEC tools."
          },
          {
            "event": "evidence_ids",
            "narration": "Each filed number comes back with its evidence ID."
          },
          {
            "event": "thinking",
            "narration": "The clock is the whole request \u2014 SEC lookups and model reasoning included."
          },
          {
            "event": "claims",
            "narration": "Four claims."
          },
          {
            "event": "lookups",
            "narration": "Four tool calls."
          },
          {
            "event": "decide",
            "narration": "Then the program decides."
          },
          {
            "event": "verdict",
            "narration": "Contradicted, with the filing."
          },
          {
            "event": "draft",
            "narration": "And here is the corrected draft."
          },
          {
            "event": "evidence",
            "narration": "Apple's annual revenue was $416.2 billion; the quarter was $102.5 billion."
          },
          {
            "event": "trace",
            "narration": "Every SEC call is on the record."
          },
          {
            "event": "each",
            "narration": "You can see each call."
          },
          {
            "event": "program",
            "narration": "The program's verdict."
          },
          {
            "event": "receipt",
            "narration": "Cost and time, on the receipt."
          }
        ]
      },
      {
        "id": "v506",
        "narration": "The same check runs locally from the command line. screenshots through Muse OCR, audio through Muse Voice Transcribe. On saved Threads posts, the median was 6.8 seconds. At that median, a thousand posts take about two hours on one worker.",
        "cue_events": [
          {
            "event": "run",
            "narration": "The same check runs locally from the command line."
          },
          {
            "event": "ocr",
            "narration": "screenshots through Muse OCR,"
          },
          {
            "event": "asr",
            "narration": "audio through Muse Voice Transcribe."
          },
          {
            "event": "median",
            "narration": "On saved Threads posts, the median was 6.8 seconds."
          },
          {
            "event": "projection",
            "narration": "At that median, a thousand posts take about two hours on one worker."
          }
        ]
      },
      {
        "id": "v507",
        "narration": "Ninety point two percent on held-out claims. It wrongly says 'supported' once in 139. Two cents and ten seconds a claim. On real posts, coverage is reported separately from accuracy.",
        "cue_events": [
          {
            "event": "accuracy",
            "narration": "Ninety point two percent on held-out claims."
          },
          {
            "event": "false_support",
            "narration": "It wrongly says 'supported' once in 139."
          },
          {
            "event": "cost_time",
            "narration": "Two cents and ten seconds a claim."
          },
          {
            "event": "coverage",
            "narration": "On real posts, coverage is reported separately from accuracy."
          }
        ]
      },
      {
        "id": "v508",
        "narration": "Every number, checked against the filing. hackathon dot dappgo dot com.",
        "cue_events": [
          {
            "event": "filing",
            "narration": "Every number, checked against the filing."
          },
          {
            "event": "url",
            "narration": "hackathon dot dappgo dot com."
          }
        ]
      },
