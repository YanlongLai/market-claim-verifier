  "m02-spread": [
    {
      "text": "Finance posts move fast.",
      "start": 5.2477,
      "end": 7.009349485
    },
    {
      "text": "Some numbers are right, some are quietly wrong, and almost nobody checks.",
      "start": 7.009349485,
      "end": 12.3677
    }
  ],
  "m03-baseline": [
    {
      "text": "Ask a language model on its own and it guesses.",
      "start": 18.1348,
      "end": 21.811858824
    },
    {
      "text": "On 357 finance claims,",
      "start": 21.811858824,
      "end": 23.533035294
    },
    {
      "text": "Muse Spark from memory was right only 20 to 44 percent of the time.",
      "start": 23.533035294,
      "end": 28.7748
    }
  ],
  "m04-extract": [
    {
      "text": "Paste a post.",
      "start": 31.1379,
      "end": 31.99188374
    },
    {
      "text": "Muse Spark pulls out each checkable claim with its exact quote.",
      "start": 31.99188374,
      "end": 36.130420325
    },
    {
      "text": "Forecasts and opinions are labeled, not judged.",
      "start": 36.130420325,
      "end": 39.2179
    }
  ],
  "m05-verdicts": [
    {
      "text": "An agent looks up SEC data for each one.",
      "start": 44.1876,
      "end": 47.895536508
    },
    {
      "text": "Amazon, 143.1 billion:",
